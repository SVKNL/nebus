# Ключ доступа к HTTP API (заголовок X-API-Key).
API_KEY=test-api-key-change-me

# PostgreSQL. Для локального запуска без Docker замените host на localhost.
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# RabbitMQ AMQP URL.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Интервал опроса таблицы outbox (секунды).
OUTBOX_POLL_INTERVAL_SECONDS=1

# Таймаут HTTP-запроса webhook в секундах.
WEBHOOK_TIMEOUT_SECONDS=10

# Логирование: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
